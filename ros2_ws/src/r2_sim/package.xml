<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_sim</name>
  <version>0.1.0</version>
  <description>ROS2D2 simulator: a room with obstacles R2 drives around in, pretend lidar and distance sensors (with noise), odometry from what the Mega bridge really sends, and a fake Mega on a pty.</description>
  <maintainer email="BeskarCode@users.noreply.github.com">NandoMadrid</maintainer>
  <license>MIT</license>
  <url type="website">https://www.astromechspain.com</url>
  <author>NandoMadrid</author>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>r2_sensors</exec_depend>
  <exec_depend>r2_shadow_bridge</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>socat</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
