<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_bringup</name>
  <version>0.1.0</version>
  <description>ROS2D2 launch files that start the demos (dome tracker...).</description>
  <maintainer email="BeskarCode@users.noreply.github.com">Fernando Beltran</maintainer>
  <license>MIT</license>
  <url type="website">https://www.astromechspain.com</url>
  <author>NandoMadrid</author>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>r2_camera</exec_depend>
  <exec_depend>r2_sensors</exec_depend>
  <exec_depend>r2_nav</exec_depend>
  <exec_depend>r2_sim</exec_depend>
  <exec_depend>r2_vision</exec_depend>
  <exec_depend>r2_dome_tracker</exec_depend>
  <exec_depend>r2_shadow_bridge</exec_depend>
  <exec_depend>r2_web</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
