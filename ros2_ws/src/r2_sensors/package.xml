<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_sensors</name>
  <version>0.1.0</version>
  <description>ROS2D2 distance sensors (VL53L0X and HC-SR04 on a Pico) and lidar: sensors.yaml, their poses on /tf_static, a simulated lidar and the scan cut to what the droid does not hide.</description>
  <maintainer email="BeskarCode@users.noreply.github.com">Fernando Beltran</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
