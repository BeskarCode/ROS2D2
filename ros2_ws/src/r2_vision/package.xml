<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_vision</name>
  <version>0.1.0</version>
  <description>ROS2D2 vision nodes: face detector (OpenCV YuNet), one instance per camera.</description>
  <maintainer email="BeskarCode@users.noreply.github.com">Fernando Beltran</maintainer>
  <license>MIT</license>
  <url type="website">https://www.astromechspain.com</url>
  <author>NandoMadrid</author>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>r2_camera</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
