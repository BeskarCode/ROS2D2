<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_shadow_bridge</name>
  <version>0.1.0</version>
  <description>ROS2D2 bridge to the ShadowMD Arduino Mega over USB serial (DM:, MD:, S1:, S3: commands).</description>
  <maintainer email="Fernando-Beltran@users.noreply.github.com">Fernando Beltran</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
